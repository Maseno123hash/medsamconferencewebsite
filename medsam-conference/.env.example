# ─────────────────────────────────────────────────────────────────────
# MEDSAM Scientific Conference & Symposium — Environment Variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────────────

# Supabase project URL (Supabase Dashboard → Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon / public API key (safe to expose in the browser;
# security is enforced by Row Level Security policies).
VITE_SUPABASE_ANON_KEY=your-anon-key
